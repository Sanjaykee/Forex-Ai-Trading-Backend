# Copy this to .env and fill in your values

# Supabase PostgreSQL connection string
# Get this from: supabase.com → your project → Settings → Database → Connection String
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT Secret — generate a random string, e.g: openssl rand -hex 32
SECRET_KEY=your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram Bot Token
# Get from: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Stripe Keys (for subscriptions — leave empty for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_ENV=production
# Your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app
