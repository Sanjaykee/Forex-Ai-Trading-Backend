ACTIVE_PROFILE=local

# ── Backtest parity settings ──────────────────────────────────────────────────
# These match run_yesterday_backtest.py exactly

# Risk per trade = $1.00 (matches backtest RISK_USD = 1.0)
RISK_PER_TRADE_USD=1.00

# Asian session enabled (backtest ALLOWED_SESSIONS includes Asian 00:00-04:00 UTC)
ALLOW_ASIAN=true

# News filter OFF (backtest trades through all news)
NEWS_FILTER=false

# Correlation bloc guard OFF (backtest evaluates each pair independently)
CORRELATION_BLOC_GUARD=false

# H1 freshness gate OFF (backtest uses last closed H1 bar regardless of age)
H1_FRESHNESS_GATE=false

# Entry drift disabled (backtest always fills at M3 trigger close, no drift check)
MAX_ENTRY_DRIFT_PIPS=999

# M3 trigger age disabled (backtest has no age check on M3 trigger)
MAX_M3_TRIGGER_AGE_MINUTES=999

# Min RR after fill (kept as secondary sanity check)
MIN_RR_AFTER_FILL=2.5

# Allow min lot over-risk so lot sizing never refuses a trade (matches backtest)
ALLOW_MIN_LOT_OVER_RISK=true
MAX_RISK_MULTIPLE=10.0
